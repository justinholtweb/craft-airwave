{
    "name": "justinholtweb/craft-airwave",
    "description": "Pull the web's feeds into your site and publish your own — an RSS, Atom and JSON Feed aggregator, importer and broadcaster for Craft CMS.",
    "type": "craft-plugin",
    "version": "5.0.0",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "airwave",
        "rss",
        "atom",
        "json feed",
        "feed",
        "feeds",
        "aggregator",
        "syndication",
        "curation"
    ],
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "docs": "https://justinholt.com/plugins/craft-airwave/docs",
        "source": "https://github.com/justinholtweb/craft-airwave",
        "issues": "https://github.com/justinholtweb/craft-airwave/issues",
        "email": "justin@justinholt.com"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "ext-mbstring": "*",
        "craftcms/cms": "^5.3.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\airwave\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\airwave\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true,
            "craftcms/generator": true
        }
    },
    "extra": {
        "name": "Airwave",
        "handle": "airwave",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-airwave/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-airwave/main/CHANGELOG.md",
        "class": "justinholtweb\\airwave\\Plugin"
    }
}
